<style is:global>
  #lightbox {
    position: fixed;
    inset: 0;
    width: 100dvw;
    height: 100dvh;
    max-width: 100dvw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.92);
  }
  #lightbox::backdrop {
    background: transparent;
  }
  #lb-img {
    transform-origin: center center;
    will-change: transform;
  }
  #aplikacja figure img {
    cursor: zoom-in;
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg  = document.getElementById('lb-img')       as HTMLImageElement;
  const lbView = document.getElementById('lb-viewport')  as HTMLDivElement;
  const lbClose = document.getElementById('lb-close')    as HTMLButtonElement;

  // ── state ────────────────────────────────────────────────────────────────
  let scale = 1, lastScale = 1;
  let tx = 0, ty = 0, lastTx = 0, lastTy = 0;
  let pinchStartDist = 0;
  let isDragging = false, mouseStartX = 0, mouseStartY = 0;
  let lastTapTime = 0;

  function applyTransform(animated = false) {
    lbImg.style.transition = animated ? 'transform 0.25s ease-out' : 'none';
    lbImg.style.transform = `translate(${tx}px,${ty}px) scale(${scale})`;
  }

  function resetTransform(animated = false) {
    scale = 1; lastScale = 1; tx = 0; ty = 0; lastTx = 0; lastTy = 0;
    applyTransform(animated);
  }

  // ── open ─────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLImageElement>('#aplikacja figure img').forEach(img => {
    img.addEventListener('click', () => {
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      resetTransform();
      dialog.showModal();
    });
  });

  // ── close ────────────────────────────────────────────────────────────────
  lbClose.addEventListener('click', () => { resetTransform(); dialog.close(); });

  // click on black backdrop area (not the image itself)
  lbView.addEventListener('click', (e) => {
    if (e.target === lbView && !isDragging) { resetTransform(); dialog.close(); }
  });

  // Escape: browser closes modal automatically; reset transform to be clean
  dialog.addEventListener('close', () => resetTransform());

  // ── touch: pinch zoom + pan ──────────────────────────────────────────────
  lbView.addEventListener('touchstart', (e) => {
    if (e.touches.length === 2) {
      pinchStartDist = Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY,
      );
    } else if (e.touches.length === 1) {
      // pan when zoomed
      mouseStartX = e.touches[0].clientX - lastTx;
      mouseStartY = e.touches[0].clientY - lastTy;

      // double-tap toggle zoom
      const now = Date.now();
      if (now - lastTapTime < 300) {
        if (scale > 1) resetTransform(true);
        else { scale = 2.5; lastScale = 2.5; applyTransform(true); }
      }
      lastTapTime = now;
    }
  }, { passive: true });

  lbView.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (e.touches.length === 2) {
      const dist = Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY,
      );
      scale = Math.min(5, Math.max(1, lastScale * dist / pinchStartDist));
      applyTransform();
    } else if (e.touches.length === 1 && scale > 1) {
      tx = e.touches[0].clientX - mouseStartX;
      ty = e.touches[0].clientY - mouseStartY;
      applyTransform();
    }
  }, { passive: false });

  lbView.addEventListener('touchend', (e) => {
    if (e.touches.length === 0) {
      lastScale = scale; lastTx = tx; lastTy = ty;
      if (scale <= 1.05) resetTransform();
    }
    isDragging = false;
  });

  // ── mouse: wheel zoom + drag (desktop) ───────────────────────────────────
  lbView.addEventListener('wheel', (e) => {
    e.preventDefault();
    scale = Math.min(5, Math.max(1, scale * (e.deltaY > 0 ? 0.85 : 1.15)));
    lastScale = scale;
    if (scale <= 1) resetTransform();
    else applyTransform();
  }, { passive: false });

  lbView.addEventListener('mousedown', (e) => {
    if (scale > 1) {
      isDragging = true;
      mouseStartX = e.clientX - lastTx;
      mouseStartY = e.clientY - lastTy;
      lbView.style.cursor = 'grabbing';
      e.preventDefault();
    }
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    tx = e.clientX - mouseStartX;
    ty = e.clientY - mouseStartY;
    applyTransform();
  });

  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    lastTx = tx; lastTy = ty;
    lbView.style.cursor = '';
  });
</script>
