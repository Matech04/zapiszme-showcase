---
export const prerender = true;

import "../styles/global.css";

const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ?? "https://admin.zapisz.me";
const registerUrl = `${dashboardUrl}/register`;
const loginUrl = `${dashboardUrl}/login`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="zapisz.me — faza testów. Aplikacja jest obecnie całkowicie darmowa. Zapisuj wizyty online, prywatny link rezerwacji."
    />
    <title>zapisz.me — faza testów (darmowa aplikacja)</title>
  </head>
  <body class="min-h-dvh bg-[#f8f3ec] text-slate-950 antialiased">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div
        class="absolute -left-24 top-20 h-72 w-72 rounded-full bg-amber-200/50 blur-3xl"
      >
      </div>
      <div
        class="absolute right-0 top-0 h-96 w-96 rounded-full bg-slate-900/10 blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-orange-200/40 blur-3xl"
      >
      </div>
    </div>

    <div
      class="relative mx-auto flex min-h-dvh max-w-3xl flex-col px-5 py-5 sm:px-8 lg:px-10"
    >
      <header
        class="flex items-center justify-between rounded-full border border-white/70 bg-white/70 px-5 py-3 shadow-sm backdrop-blur"
      >
        <a href="/" class="flex items-center gap-3" aria-label="zapisz.me">
          <span
            class="grid size-9 place-items-center rounded-full bg-slate-950 text-sm font-black text-white"
            >z</span
          >
          <span class="text-lg font-black tracking-tight text-slate-950"
            >zapisz.me</span
          >
        </a>
        <a
          href={registerUrl}
          class="rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800"
        >
          Załóż konto
        </a>
      </header>

      <main class="flex flex-1 flex-col justify-center py-14 md:py-20">
        <p
          class="mb-6 inline-flex w-fit rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-black text-emerald-900 shadow-sm"
        >
          Faza testów — aplikacja jest teraz w pełni darmowa
        </p>
        <h1
          class="text-4xl font-black tracking-tight text-slate-950 sm:text-5xl lg:text-6xl"
        >
          Testujemy produkt. Nie pobieramy opłat.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-700 sm:text-xl">
          Obecnie skupiamy się na stabilności i jakości doświadczenia. Z tego
          powodu <strong>korzystanie z aplikacji jest bezpłatne</strong> na czas
          testów — bez ukrytych kosztów i bez konieczności podpinania karty na
          start.
        </p>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Po zakończeniu fazy testów poinformujemy o zasadach rozliczeń z
          wyprzedzeniem. Jeśli masz uwagi lub znajdziesz błąd, napisz na{" "}
          <a
            class="font-bold text-slate-950 underline decoration-amber-400 decoration-2 underline-offset-2 hover:decoration-amber-600"
            href="mailto:kontakt@zapisz.me?subject=Faza testów zapisz.me"
            >kontakt@zapisz.me</a
          >.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={registerUrl}
            class="rounded-full bg-slate-950 px-7 py-4 text-center text-base font-bold text-white shadow-lg shadow-slate-900/15 transition hover:-translate-y-0.5 hover:bg-slate-800"
          >
            Załóż darmowe konto
          </a>
          <a
            href={loginUrl}
            class="rounded-full border border-slate-300 bg-white/70 px-7 py-4 text-center text-base font-bold text-slate-950 transition hover:-translate-y-0.5 hover:bg-white"
          >
            Mam już konto — logowanie
          </a>
          <a
            href="/demo-kalendarz"
            class="rounded-full border border-slate-300 bg-white/70 px-7 py-4 text-center text-base font-bold text-slate-950 transition hover:-translate-y-0.5 hover:bg-white"
          >
            Demo kalendarza klienta
          </a>
        </div>
      </main>

      <footer
        class="flex flex-col gap-3 border-t border-slate-950/10 py-8 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© 2026 zapisz.me — faza testów.</p>
        <div class="flex flex-wrap gap-4">
          <a class="hover:text-slate-950" href="/regulamin">Regulamin</a>
          <a class="hover:text-slate-950" href="/polityka-prywatnosci"
            >Polityka prywatności</a
          >
          <a class="font-bold text-slate-950" href="mailto:kontakt@zapisz.me"
            >kontakt@zapisz.me</a
          >
        </div>
      </footer>
    </div>
  </body>
</html>
