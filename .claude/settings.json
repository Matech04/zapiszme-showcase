{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/worktree-ports.sh",
            "timeout": 30,
            "statusMessage": "Assigning dev ports..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Task completed' 2>/dev/null || true"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/worktree-remove.sh",
            "timeout": 30,
            "statusMessage": "Cleaning up worktree..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "mcp__playwright",
      "mcp__chrome-devtools"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(dropdb *)",
      "Bash(mysqladmin drop*)",
      "Bash(psql * -c \"DROP *\")"
    ]
  }
}
