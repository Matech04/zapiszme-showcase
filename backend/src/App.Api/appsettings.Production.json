{
  "Dashboard": {
    "BaseUrl": "https://admin.zapisz.me"
  },
  "Turnstile": {
    "Enabled": true,
    "SiteKey": "",
    "SecretKey": "",
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://admin.zapisz.me",
      "https://zapisz.me",
      "https://www.zapisz.me"
    ]
  },
  "Payments": {
    "WebBaseUrl": "https://zapisz.me"
  },
  "ShortLink": {
    "BaseUrl": "https://zapisz.me"
  },
  "ReverseProxy": {
    "TrustedProxies": [
      "127.0.0.1",
      "172.16.0.0/12",
      "10.0.0.0/8"
    ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PublicBookingWrite": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Webhook": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
