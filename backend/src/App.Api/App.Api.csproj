<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7c8e3f2a-9b1d-4e6f-a5c3-2d8e1f0a4b6c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.2" />
    <!-- Override tranzytywnej MessagePack 2.5.187 (z SignalR.StackExchangeRedis) — GHSA-hv8m-jj95-wg3x
         (DoS przy deserializacji). Trzymamy się linii 2.5.x dla kompatybilności z SignalR.Redis. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="MessagePack.Annotations" Version="2.5.302" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
    <PackageReference Include="NSwag.MSBuild" Version="14.6.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <!-- FakeTimeProvider używany TYLKO w env "E2E" - guard w Program.cs. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../App.Application/App.Application.csproj" />
    <ProjectReference Include="../App.Infrastructure/App.Infrastructure.csproj" />
    <!-- E2eSupport zawiera klasy aktywowane tylko w ASPNETCORE_ENVIRONMENT=E2E
         (TestEmailTransport, TestAuthEmailMailbox, RestApiIntegrationSeed itp.).
         W Production env binarki są obecne, ale niedostępne — guard w Program.cs. -->
    <ProjectReference Include="../App.Api.E2eSupport/App.Api.E2eSupport.csproj" />
  </ItemGroup>

  <!-- NSwag uruchamia aplikację bez PostgreSQL — SKIP_DB_STARTUP pomija Migrate/Seed w Program.cs -->
  <PropertyGroup>
    <_NswagEnvPrefix Condition="$([MSBuild]::IsOSPlatform('windows'))">set SKIP_DB_STARTUP=1&amp;&amp; </_NswagEnvPrefix>
    <_NswagEnvPrefix Condition="!$([MSBuild]::IsOSPlatform('windows'))">SKIP_DB_STARTUP=1 </_NswagEnvPrefix>
  </PropertyGroup>
  <Target Name="NSwag" AfterTargets="Build" Condition="'$(SkipNSwagBuild)' != 'true'">
    <Exec Command="$(_NswagEnvPrefix)$(NSwagExe_Net100) run nswag.json /variables:Configuration=$(Configuration)" />
    <Exec Command="$(_NswagEnvPrefix)$(NSwagExe_Net100) run nswag.booking.json /variables:Configuration=$(Configuration)" />
  </Target>

</Project>
