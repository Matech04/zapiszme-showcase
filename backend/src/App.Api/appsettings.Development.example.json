{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=App_db;Username=postgres;Password=CHANGE_ME"
  },
  "Dashboard": {
    "BaseUrl": "http://localhost:4200"
  },
  "Turnstile": {
    "Enabled": false,
    "SiteKey": "",
    "SecretKey": "",
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "AzureCommunication": {
    "Email": {
      "ConnectionString": "endpoint=...;accesskey=...",
      "SenderAddress": "donotreply@yourdomain.com"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://dashboard.example.com"
    ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "PublicBookingWrite": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  // SMS via smsapi.pl. Trzy tryby:
  //  1) DevBackdoorLogCode=true (default w appsettings.Development.json) — kod w logach, brak wysyłki.
  //  2) DevBackdoorLogCode=false + OAuthToken="..." + TestMode=true — smsapi.pl symuluje (status=QUEUE), SMS NIE dochodzi.
  //  3) DevBackdoorLogCode=false + OAuthToken="..." + TestMode=false — realna wysyłka, kosztuje, wymaga zarejestrowanego SenderName.
  // Aby manualnie przetestować flow z prawdziwym SMS na własny telefon: opcja 3 w appsettings.Development.local.json.
  "Sms": {
    "BaseUrl": "https://api.smsapi.pl/",
    "OAuthToken": "wklej-token-z-panelu-smsapi.pl",
    "SenderName": "INFO",
    "TestMode": false,
    "DevBackdoorLogCode": false
  },
  // Zadatki. Dwa tryby w dev:
  //  1) DevFakeProvider=true (default w appsettings.Development.json) — pozorny provider: onboarding
  //     kończy się od razu, konto przyjmuje płatności, checkout prowadzi na stronę sukcesu.
  //     Wizyta zmienia się w „opłaconą" dopiero po ręcznym POST na /api/payments/webhook.
  //  2) DevFakeProvider=false + Stripe.SecretKey="sk_test_..." — realne Stripe Connect (tryb testowy).
  // W Production flaga jest ignorowana (guard w Program.cs).
  "Payments": {
    "DevFakeProvider": true,
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": ""
    }
  }
}
